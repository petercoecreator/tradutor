	pop.Visible = true
end)

--==================== ENVIO ====================--
local function outgoing(raw)
	local tone, shout = getTone(raw)
	local clean, direct, laugh = preparePT(raw)
	local out = ""
	if direct then
		out = direct
	elseif hasLetters(clean) then
		local r = translate(clean, "pt", CONFIG.Lang)
		if not r then return nil end
		out = naturalize(r)
		if CONFIG.SlangMode then out = slangify(out, L().reverse) end
	end
	if laugh then out = out == "" and L().laugh or (out .. " " .. L().laugh) end
	if out == "" then return nil end
	return applyTone(out, tone, shout)
end

local busy = false
local function doSend()
	local raw = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if raw == "" or busy then return end
	busy = true
	box.Text = ""
	hidePop()
	task.spawn(function()
		local out = outgoing(raw)
		if out and sendChat(out) then
			addMessage("Você → " .. L().name, raw, out, L().color)
		else
			addMessage("Erro", raw, "não foi possível traduzir/enviar", Color3.fromRGB(200, 80, 80))
		end
		busy = false
	end)
end

box.FocusLost:Connect(function(enter) if enter then doSend() end end)
sendBtn.MouseButton1Click:Connect(doSend)

--==================== RECEBER ====================--
local function onIncoming(text, uid, name)
	if uid == player.UserId and not CONFIG.ShowOwn then return end
	task.spawn(function()
		local tr, lang = translateIncoming(text, uid)
		if tr and LANG[lang] then
			addMessage(name .. " " .. LANG[lang].flag, text, tr, LANG[lang].color)
		end
	end)
end

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.MessageReceived:Connect(function(msg)
		local src = msg.TextSource
		if not src then return end
		local plr = Players:GetPlayerByUserId(src.UserId)
		onIncoming(msg.Text, src.UserId, plr and plr.DisplayName or src.Name)
	end)
else
	local function hook(p)
		p.Chatted:Connect(function(m) onIncoming(m, p.UserId, p.DisplayName) end)
	end
	for _, p in ipairs(Players:GetPlayers()) do hook(p) end
	Players.PlayerAdded:Connect(hook)
end

