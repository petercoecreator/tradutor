local speakerLang = {}

local function translateIncoming(raw, uid)
	if not hasLetters(raw) then return nil, nil end

	local gTxt, g = translate(raw, "auto", "pt")
	local h, hs, second = guessLang(raw)
	local words = wordCount(raw)
	local strong = hs - second >= 2
	local lang

	if strong then
		lang = h
	elseif words <= 2 and hs == 0 and uid and speakerLang[uid] then
		lang = speakerLang[uid]
	elseif g == "en" or g == "es" or g == "pt" then
		lang = (hs > second and words <= 4) and h or g
	elseif hs > second then
		lang = h
	elseif uid and speakerLang[uid] then
		lang = speakerLang[uid]
	end

	if lang ~= "en" and lang ~= "es" then return nil, lang end
	if uid and ((hs > second and h == lang) or words >= 3) then speakerLang[uid] = lang end

	local d = LANG[lang]
	local text = expandSlang(raw, d.slang)

	local key = text:lower():gsub("¿", ""):gsub("¡", ""):gsub("^%s+", ""):gsub("[%s%.!%?]+$", "")
	if d.short[key] then return d.short[key], lang, text end

	local out
	if g == lang and text == raw and gTxt then
		out = gTxt
	else
		out = translate(text, lang, "pt")
	end
	return fixPT(out or text), lang, text
end

