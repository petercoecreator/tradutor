local function editDist(a, b, max)
	local la, lb = #a, #b
	if math.abs(la - lb) > max then return max + 1 end
	local prev2, prev, cur = {}, {}, {}
	for j = 0, lb do prev[j] = j end
	for i = 1, la do
		cur = { [0] = i }
		local rowMin = i
		for j = 1, lb do
			local cost = (a:sub(i, i) == b:sub(j, j)) and 0 or 1
			local v = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
			if i > 1 and j > 1 and a:sub(i, i) == b:sub(j - 1, j - 1) and a:sub(i - 1, i - 1) == b:sub(j, j) then
				v = math.min(v, prev2[j - 2] + 1)
			end
			cur[j] = v
			if v < rowMin then rowMin = v end
		end
		if rowMin > max then return max + 1 end
		prev2, prev = prev, cur
	end
	return prev[lb]
end

local function fixTypo(core, k)
	if PT_DICT[k] then return PT_DICT[k] end
	if #k < 4 or not k:match("^%a+$") then return nil end
	local hadAccent = core:lower() ~= k
	local max = (hadAccent or #k >= 8) and 2 or 1
	if not hadAccent and #k < 5 then return nil end
	local best, bestD = nil, max + 1
	for i, norm in ipairs(BUCKET[k:sub(1, 1)] or {}) do
		if math.abs(#norm - #k) <= max then
			local d = editDist(k, norm, max)
			if d < bestD then best, bestD = PT_DICT[norm], d end
			if d == 1 and max == 1 then break end
		end
		if i % 5000 == 0 then task.wait() end -- evita travar
	end
	return best
end

local function preparePT(text)
	local laugh, words = false, {}
	for w in text:gmatch("%S+") do
		local _, core, punct = splitWord(w)
		local k = stripAccents(core:lower())
		if isLaugh(k) then
			laugh = true
		else
			table.insert(words, PT_ABBR[k] and (PT_ABBR[k] .. punct) or w)
		end
	end
	local clean = table.concat(words, " ")
	return clean, L().direct[normKey(stripAccents(clean))], laugh
end

local function naturalize(txt)
	local t = " " .. txt:lower() .. " "
	for _, p in ipairs(L().natural) do
		local pat = p[1]:gsub("%p", "%%%0")
		t = t:gsub("%f[%w']" .. pat .. "%f[^%w']", p[2])
	end
	t = t:gsub("^%s+", ""):gsub("%s+$", "")
	t = t:gsub("%.$", "")
	return t
end

local function getTone(text)
	text = text:gsub("…", "...")
	local tail = text:match("([%.%?!]+)%s*$") or ""
	local tone = ""
	if tail:find("%?") and tail:find("!") then tone = "?!"
	elseif tail:find("%?%?") then tone = "??"
	elseif tail:find("%?") then tone = "?"
	elseif tail:find("%.%.") then tone = "..."
	elseif tail:find("!!") then tone = "!!"
	elseif tail:find("!") then tone = "!"
	end
	local letters = stripAccents(text):gsub("[^%a]", "")
	local shout = #letters >= 3 and letters == letters:upper()
	return tone, shout
end

local function applyTone(s, tone, shout)
	if tone ~= "" then s = s:gsub("[%.%?!…]+%s*$", "") .. tone end
	return shout and s:upper() or s
end

local function fixPT(s)
	return (s:gsub("%a+", function(w)
		local l = w:lower()
		if #l >= 4 and (l:match("^[ha]+$") or l:match("^[ja]+$") or l:match("^[he]+$") or l:match("^[je]+$"))
			and l:find("[hj][ae]") then
			return "kkkk"
		end
	end))
end

--==================== GOOGLE TRADUTOR ====================--
local cache = {}
local lastReq = 0
local MIN_GAP = 0.25

local function urlEncode(s)
	return (s:gsub("[^%w%-_%.~]", function(c) return string.format("%%%02X", string.byte(c)) end))
end

local function httpGet(url)
	local waitT = MIN_GAP - (tick() - lastReq)
	if waitT > 0 then task.wait(waitT) end
	lastReq = tick()

	local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
	if not ok or not res then return nil, 0 end
	local code = tonumber(res.StatusCode) or 0
	if code ~= 200 or not res.Body then return nil, code end
	local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not ok2 then return nil, code end
	return data, code
end

local function viaGtx(text, sl, tl)
	local data, code = httpGet(("https://translate.googleapis.com/translate_a/single?client=gtx&sl=%s&tl=%s&dt=t&q=%s"):format(sl, tl, urlEncode(text)))
	if type(data) ~= "table" then return nil, nil, code end
	local parts = {}
	for _, seg in ipairs(data[1] or {}) do
		if type(seg) == "table" and type(seg[1]) == "string" then table.insert(parts, seg[1]) end
	end
	local r = table.concat(parts)
	if r == "" then return nil, nil, code end
	return r, data[3], code
end

local function viaClients5(text, sl, tl)
	local data, code = httpGet(("https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=%s&tl=%s&q=%s"):format(sl, tl, urlEncode(text)))
	if type(data) ~= "table" then return nil, nil, code end
	local first = data[1]
	if type(first) == "table" then return first[1], first[2] or (sl ~= "auto" and sl or nil), code end
	if type(first) == "string" then return first, (sl ~= "auto" and sl or nil), code end
	return nil, nil, code
end

local function viaMyMemory(text, sl, tl)
	if sl == "auto" then return nil end
	local data, code = httpGet(("https://api.mymemory.translated.net/get?q=%s&langpair=%s%%7C%s"):format(urlEncode(text), sl, tl))
	local r = type(data) == "table" and data.responseData and data.responseData.translatedText
	if type(r) ~= "string" or r == "" or r:find("MYMEMORY WARNING") then return nil, nil, code end
	return r, sl, code
end

local PROVIDERS = { viaGtx, viaClients5, viaMyMemory }

local function translate(text, sl, tl)
	sl, tl = sl or "auto", tl or "pt"
	local ck = sl .. "|" .. tl .. "|" .. text
	if cache[ck] then return cache[ck][1], cache[ck][2] end
	if not httpRequest then return nil, nil end

	for attempt = 1, 3 do
		for _, fn in ipairs(PROVIDERS) do
			local ok, r, lang, code = pcall(fn, text, sl, tl)
			if ok and r then
				cache[ck] = { r, lang }
				return r, lang
			end
			if code == 429 then task.wait(0.5 * attempt) end
		end
		task.wait(0.6 * attempt)
	end
	warn("[Tradutor] todas as tentativas falharam:", text)
	return nil, nil
end

