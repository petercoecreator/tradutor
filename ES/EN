local function sendChat(msg)
	local ok, err = pcall(function()
		local cfg = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
		local ch = cfg and cfg.TargetTextChannel
		if not ch then
			local channels = TextChatService:FindFirstChild("TextChannels")
			if channels then
				ch = channels:FindFirstChild("RBXGeneral")
				if not ch then
					for _, c in ipairs(channels:GetChildren()) do
						if c:IsA("TextChannel") then ch = c break end
					end
				end
			end
		end
		if not ch then error("nenhum TextChannel encontrado") end
		ch:SendAsync(msg)
	end)
	if ok then return true end
	warn("[Tradutor] TextChatService falhou:", err)

	local ok2, err2 = pcall(function()
		local ev = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 2)
		ev = ev and ev:FindFirstChild("SayMessageRequest")
		if not ev then error("SayMessageRequest não encontrado") end
		ev:FireServer(msg, "All")
	end)
	if ok2 then return true end
	warn("[Tradutor] Chat legado falhou:", err2)
	return false
end

