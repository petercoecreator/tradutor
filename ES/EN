local function addDict(w)
	local k = stripAccents(w:lower())
	if PT_DICT[k] then return end
	PT_DICT[k] = w
	local c = k:sub(1, 1)
	BUCKET[c] = BUCKET[c] or {}
	table.insert(BUCKET[c], k)
end
