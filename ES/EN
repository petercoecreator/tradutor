--==================== FUNÇÕES DE TEXTO ====================--
local function capRuns(s, n)
	local out, prev, run = {}, "", 0
	for ch in s:gmatch(".") do
		if ch == prev then run += 1 else prev, run = ch, 1 end
		if run <= n then out[#out + 1] = ch end
	end
	return table.concat(out)
end

local function lookup(dict, k)
	if k == "" then return nil end
	return dict[k] or dict[capRuns(k, 2)] or dict[capRuns(k, 1)]
end

local function splitWord(w)
	local pre = ""
	while true do
		local c = w:sub(1, 2)
		if c == "¿" or c == "¡" then pre = pre .. c; w = w:sub(3) else break end
	end
	local lead, core, punct = w:match("^(%p*)(.-)(%p*)$")
	return pre .. (lead or ""), core or w, punct or ""
end

local function expandSlang(text, dict)
	local out = {}
	for word in text:gmatch("%S+") do
		local full = dict[word:lower()]
		if full then
			table.insert(out, full)
		else
			local pre, core, punct = splitWord(word)
			local rep = lookup(dict, core:lower())
			table.insert(out, rep and (pre .. rep .. punct) or word)
		end
	end
	return table.concat(out, " ")
end

local function slangify(text, rev)
	text = " " .. text:lower() .. " "
	for _, pair in ipairs(rev) do
		local pat = pair[1]:gsub("%p", "%%%0")
		text = text:gsub("%f[%w']" .. pat .. "%f[^%w']", pair[2])
	end
	text = text:gsub("^%s+", ""):gsub("%s+$", "")
	text = text:gsub("%.$", ""):gsub("!+$", "!")
	return text
end

local function normKey(s)
	s = s:lower():gsub("[%p%s]+$", "")
	s = s:gsub("^%s+", "")
	return s
end

