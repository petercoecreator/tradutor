local function guessLang(raw)
	local low = raw:lower()
	local sc = { en = 0, es = 0, pt = 0 }
	if low:find("ñ") or low:find("Ñ") or raw:find("¿") or raw:find("¡") then sc.es += 3 end
	if low:find("ã") or low:find("õ") or low:find("ç") then sc.pt += 3 end
	if low:find("kkk") then sc.pt += 2 end
	local norm = stripAccents(low)
	for w in norm:gmatch("[%a']+") do
		if EN_W[w] then sc.en += 1 end
		if ES_W[w] then sc.es += 1 end
		if PT_W[w] then sc.pt += 1 end
	end
	local best, bs, second = nil, 0, 0
	for lang, v in pairs(sc) do
		if v > bs then best, second, bs = lang, bs, v
		elseif v > second then second = v end
	end
	return best, bs, second
end

