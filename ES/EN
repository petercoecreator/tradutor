--==================== INTRO v3 (petercoe1) ====================--
do
	local Players      = game:GetService("Players")
	local TweenService = game:GetService("TweenService")
	local Lighting     = game:GetService("Lighting")
	local Debris       = game:GetService("Debris")
	local player       = Players.LocalPlayer
	local CREATOR_ID   = 7719697513
	local BLUE, RED    = Color3.fromRGB(90, 140, 255), Color3.fromRGB(235, 90, 70)
	local WHITE        = Color3.new(1, 1, 1)

	local function tw(o, t, p, style, dir, rep, rev)
		local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint,
			dir or Enum.EasingDirection.Out, rep or 0, rev or false), p)
		x:Play()
		return x
	end
	local function corner(o, r) Instance.new("UICorner", o).CornerRadius = r or UDim.new(1, 0) end
	local function duoGrad(o)
		local g = Instance.new("UIGradient", o)
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, BLUE), ColorSequenceKeypoint.new(0.5, RED), ColorSequenceKeypoint.new(1, BLUE),
		})
		return g
	end
	local function loadThumb(img, id)
		task.spawn(function()
			local ok, res = pcall(Players.GetUserThumbnailAsync, Players, id,
				Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
			if ok then img.Image = res end
		end)
	end

	local intro = Instance.new("ScreenGui")
	intro.Name, intro.ResetOnSpawn, intro.DisplayOrder, intro.IgnoreGuiInset = "TranslatorIntro", false, 100, true
	intro.Parent = (gethui and gethui()) or player:WaitForChild("PlayerGui")

	local blur = Instance.new("BlurEffect")
	blur.Size, blur.Parent = 0, Lighting
	tw(blur, 0.6, { Size = 20 })

	local bg = Instance.new("Frame")
	bg.Size, bg.BackgroundColor3, bg.BackgroundTransparency = UDim2.fromScale(1, 1), Color3.fromRGB(8, 8, 14), 1
	bg.Parent = intro
	local bgGrad = Instance.new("UIGradient", bg)
	bgGrad.Color = ColorSequence.new(Color3.fromRGB(20, 25, 60), Color3.fromRGB(50, 15, 15))
	bgGrad.Rotation = 45
	tw(bg, 0.6, { BackgroundTransparency = 0.25 })
	tw(bgGrad, 5, { Rotation = 225 }, Enum.EasingStyle.Linear)

	local running = true
	task.spawn(function()
		while running do
			local p = Instance.new("Frame")
			local s = math.random(3, 7)
			p.Size, p.Position = UDim2.fromOffset(s, s), UDim2.fromScale(math.random(), 1.05)
			p.BackgroundColor3 = math.random() > 0.5 and BLUE or RED
			p.BackgroundTransparency, p.BorderSizePixel = 0.2, 0
			p.Parent = bg
			corner(p)
			local t = math.random(25, 45) / 10
			tw(p, t, { Position = UDim2.fromScale(p.Position.X.Scale + (math.random() - 0.5) * 0.15, -0.05),
				BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
			Debris:AddItem(p, t)
			task.wait(0.05)
		end
	end)

	local card = Instance.new("Frame")
	card.AnchorPoint, card.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.65)
	card.Size, card.BackgroundColor3 = UDim2.fromOffset(350, 320), Color3.fromRGB(16, 16, 22)
	card.ClipsDescendants, card.Rotation = true, -8
	card.Parent = intro
	corner(card, UDim.new(0, 18))
	local cs = Instance.new("UIStroke", card); cs.Thickness = 2.5; cs.Color = WHITE
	local csGrad = duoGrad(cs)
	local scale = Instance.new("UIScale", card); scale.Scale = 0

	local shine = Instance.new("Frame")
	shine.Size, shine.BackgroundColor3 = UDim2.fromScale(1, 1), WHITE
	shine.BackgroundTransparency, shine.BorderSizePixel, shine.ZIndex = 0, 0, 10
	shine.Parent = card
	corner(shine, UDim.new(0, 18))
	local shineGrad = Instance.new("UIGradient", shine)
	shineGrad.Rotation = 20
	shineGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.42, 1),
		NumberSequenceKeypoint.new(0.5, 0.7),
		NumberSequenceKeypoint.new(0.58, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	shineGrad.Offset = Vector2.new(-1, 0)

	local function playShine(t)
		shineGrad.Offset = Vector2.new(-1, 0)
		tw(shineGrad, t, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Quad)
	end

	local glow = Instance.new("Frame")
	glow.AnchorPoint, glow.Position = Vector2.new(0.5, 0.5), UDim2.new(0.5, 0, 0, 78)
	glow.Size, glow.BackgroundColor3, glow.BackgroundTransparency = UDim2.fromOffset(130, 130), BLUE, 0.7
	glow.Parent = card
	corner(glow)
	local glowScale = Instance.new("UIScale", glow)

	local ring = Instance.new("Frame")
	ring.AnchorPoint, ring.Position = Vector2.new(0.5, 0.5), UDim2.new(0.5, 0, 0, 78)
	ring.Size, ring.BackgroundColor3 = UDim2.fromOffset(112, 112), WHITE
	ring.Parent = card
	corner(ring)
	local ringGrad = duoGrad(ring)
	local ringScale = Instance.new("UIScale", ring); ringScale.Scale = 0

	local avatar = Instance.new("ImageLabel")
	avatar.AnchorPoint, avatar.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
	avatar.Size, avatar.BackgroundColor3 = UDim2.new(1, -8, 1, -8), Color3.fromRGB(30, 30, 42)
	avatar.Parent = ring
	corner(avatar)
	loadThumb(avatar, player.UserId)

	local function txt(parent, t, pos, size, font, color, align)
		local l = Instance.new("TextLabel")
		l.Position, l.BackgroundTransparency = pos, 1
		l.Size = UDim2.new(1, -20, 0, size + 6)
		if not align then l.AnchorPoint = Vector2.new(0.5, 0) end
		l.TextXAlignment = align or Enum.TextXAlignment.Center
		l.Text, l.Font, l.TextSize, l.TextColor3, l.TextTransparency = t, font, size, color, 1
		l.Parent = parent
		return l
	end

	local welcome = txt(card, "Bem-vindo ao tradutor ES/EN,", UDim2.new(0.5, 0, 0, 150), 18, Enum.Font.GothamBold, WHITE)
	local name    = txt(card, player.DisplayName .. "!", UDim2.new(0.5, 0, 0, 176), 24, Enum.Font.GothamBlack, WHITE)
	local nameGrad = duoGrad(name)
	local nameScale = Instance.new("UIScale", name); nameScale.Scale = 0.5

	local barBg = Instance.new("Frame")
	barBg.AnchorPoint, barBg.Position = Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 218)
	barBg.Size, barBg.BackgroundColor3, barBg.BackgroundTransparency = UDim2.fromOffset(260, 6), Color3.fromRGB(40, 40, 55), 1
	barBg.Parent = card
	corner(barBg)
	local fill = Instance.new("Frame")
	fill.Size, fill.BackgroundColor3 = UDim2.fromScale(0, 1), WHITE
	fill.Parent = barBg
	corner(fill)
	duoGrad(fill)
	local pct = txt(card, "0%", UDim2.new(0.5, 0, 0, 228), 11, Enum.Font.GothamMedium, Color3.fromRGB(150, 150, 170))

	local line = Instance.new("Frame")
	line.AnchorPoint, line.Position = Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 258)
	line.Size, line.BackgroundColor3, line.BorderSizePixel = UDim2.fromOffset(0, 1), Color3.fromRGB(60, 60, 80), 0
	line.Parent = card

	local credit = Instance.new("Frame")
	credit.AnchorPoint, credit.Position = Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 290)
	credit.Size, credit.BackgroundTransparency = UDim2.fromOffset(170, 32), 1
	credit.Parent = card

	local cRing = Instance.new("Frame")
	cRing.Size, cRing.BackgroundColor3 = UDim2.fromOffset(30, 30), WHITE
	cRing.BackgroundTransparency = 1
	cRing.Parent = credit
	corner(cRing)
	local cRingGrad = duoGrad(cRing)

	local cAvatar = Instance.new("ImageLabel")
	cAvatar.AnchorPoint, cAvatar.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
	cAvatar.Size, cAvatar.BackgroundColor3 = UDim2.new(1, -4, 1, -4), Color3.fromRGB(30, 30, 42)
	cAvatar.BackgroundTransparency, cAvatar.ImageTransparency = 1, 1
	cAvatar.Parent = cRing
	corner(cAvatar)
	loadThumb(cAvatar, CREATOR_ID)

	local cBy = txt(credit, "criado por", UDim2.fromOffset(38, 0), 10, Enum.Font.Gotham,
		Color3.fromRGB(130, 130, 150), Enum.TextXAlignment.Left)
	local cName = txt(credit, "petercoe1", UDim2.fromOffset(38, 13), 13, Enum.Font.GothamBold,
		Color3.fromRGB(200, 200, 215), Enum.TextXAlignment.Left)

	task.spawn(function()
		while running do
			ringGrad.Rotation = (ringGrad.Rotation + 5) % 360
			cRingGrad.Rotation = (cRingGrad.Rotation + 5) % 360
			csGrad.Rotation = (csGrad.Rotation + 2) % 360
			task.wait()
		end
	end)
	tw(glowScale, 0.9, { Scale = 1.25 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	tw(glow, 0.9, { BackgroundTransparency = 0.9 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	nameGrad.Offset = Vector2.new(-1, 0)
	tw(nameGrad, 1.5, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Linear, nil, -1)

	tw(card, 0.7, { Position = UDim2.fromScale(0.5, 0.5), Rotation = 0 }, Enum.EasingStyle.Back)
	tw(scale, 0.7, { Scale = 1 }, Enum.EasingStyle.Back).Completed:Wait()
	playShine(0.8)

	tw(ringScale, 0.8, { Scale = 1 }, Enum.EasingStyle.Elastic)
	task.wait(0.35)

	welcome.TextTransparency, welcome.MaxVisibleGraphemes = 0, 0
	for i = 1, utf8.len(welcome.Text) do welcome.MaxVisibleGraphemes = i; task.wait(0.025) end

	tw(name, 0.4, { TextTransparency = 0 })
	tw(nameScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Elastic)
	task.wait(0.3)

	tw(line, 0.5, { Size = UDim2.fromOffset(220, 1) })
	tw(credit, 0.5, { Position = UDim2.new(0.5, 0, 0, 272) }, Enum.EasingStyle.Back)
	tw(cRing, 0.4, { BackgroundTransparency = 0 })
	tw(cAvatar, 0.4, { BackgroundTransparency = 0, ImageTransparency = 0 })
	tw(cBy, 0.4, { TextTransparency = 0 })
	tw(cName, 0.4, { TextTransparency = 0 })
	task.wait(0.2)

	tw(barBg, 0.3, { BackgroundTransparency = 0 })
	tw(pct, 0.3, { TextTransparency = 0 })
	local dur, t0 = 1.6, tick()
	tw(fill, dur, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	while tick() - t0 < dur do
		pct.Text = math.floor((tick() - t0) / dur * 100) .. "%"
		task.wait()
	end
	pct.Text = "✓ Pronto!"
	playShine(0.6)
	task.wait(0.7)

	tw(ringScale, 0.3, { Scale = 1.2 }, Enum.EasingStyle.Quad)
	task.wait(0.15)
	tw(card, 0.5, { Rotation = 10, Position = UDim2.fromScale(0.5, 0.4) }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tw(scale, 0.5, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	tw(bg, 0.6, { BackgroundTransparency = 1 })
	tw(blur, 0.6, { Size = 0 }).Completed:Wait()

	running = false
	blur:Destroy()
	intro:Destroy()
end
