local function onMessage(speaker, text)
	if not text or text:match("^%s*$") then return end
	if speaker == player and not CONFIG.ShowOwn then return end
	text = text:gsub("<[^>]+>", "")

	task.spawn(function()
		local uid = speaker and speaker.UserId
		local translated, lang, expanded = translateIncoming(text, uid)
		if lang ~= "en" and lang ~= "es" then return end
		local name = (speaker and speaker.DisplayName or "?") .. " " .. LANG[lang].flag
		addEntry(name, text, translated or expanded)
	end)
end

