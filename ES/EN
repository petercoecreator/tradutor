--==================== ENVIO (PT → EN/ES) ====================--
local sending = false
local function submit()
	local text = box.Text
	if sending or text:match("^%s*$") then return end
	sending = true
	box.Text = ""
	box.PlaceholderText = "Traduzindo..."

	task.spawn(function()
		local tl = CONFIG.Lang
		local d = LANG[tl]
		local clean, direct, laugh = preparePT(text)
		local out = direct

		if not out and clean ~= "" then
			out = translate(clean, "pt", tl)
			if out and out ~= "" then
				out = naturalize(out)
				if CONFIG.SlangMode then out = slangify(out, d.reverse) end
			end
		end

		local tone, shout = getTone(text)
		if out and out ~= "" then
			out = applyTone(out, tone, shout)
			if tl == "es" then
				out = out:gsub("^¿", ""):gsub("^¡", "")
				if out:find("%?") then out = "¿" .. out
				elseif out:find("!") then out = "¡" .. out end
			end
		end
		if laugh then out = (out and out ~= "") and (out .. " " .. d.laugh) or d.laugh end

		if out and out ~= "" then
			if sendChat(out) then
				addEntry("Você", text, out, true, d.flag)
			else
				addEntry("Erro", text, "não foi possível enviar ao chat (veja F9)", true)
			end
		else
			addEntry("Erro", text, "falha na tradução", true)
		end
		box.PlaceholderText = placeholder()
		sending = false
	end)
end

